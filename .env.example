# =====================================================================
# KrishiBazaar - Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env   (or 'Copy-Item .env.example .env' in PowerShell)
# DO NOT commit the .env file containing real secrets to Git.
# =====================================================================

# --- Network & Agent Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Agentverse & ASI:One Credentials ---
# Required only when registering/deploying agents to Agentverse or Mailbox
AGENTVERSE_API_KEY=your_agentverse_api_key_here
AGENTVERSE_URL=https://agentverse.ai

# --- Private Agent Seeds (Use unique, random seeds in production) ---
# For local development, seeds ensure consistent agent addresses across restarts.
ORCHESTRATOR_AGENT_SEED=krishibazaar_orchestrator_local_dev_seed_change_in_prod
MARKET_AGENT_SEED=krishibazaar_market_local_dev_seed_change_in_prod
WEATHER_AGENT_SEED=krishibazaar_weather_local_dev_seed_change_in_prod
BUYER_AGENT_SEED=krishibazaar_buyer_local_dev_seed_change_in_prod
TRANSPORT_AGENT_SEED=krishibazaar_transport_local_dev_seed_change_in_prod

# --- Agent Endpoint Ports (Local Multi-Agent Execution) ---
ORCHESTRATOR_PORT=8000
MARKET_AGENT_PORT=8001
WEATHER_AGENT_PORT=8002
BUYER_AGENT_PORT=8003
TRANSPORT_AGENT_PORT=8004

# --- External API Keys ---
# Official Indian Open Government Data (data.gov.in) API Key for Agmarknet Mandi data.
# When left empty, Market Agent transparently serves verified benchmark mandi records.
DATAGOV_API_KEY=

# Open-Meteo does not require an API key (free & open service)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Persistent Storage ---
DATABASE_PATH=krishibazaar.db
