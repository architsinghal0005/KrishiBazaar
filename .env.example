# =====================================================================
# KrishiBazaar - Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env   (or 'Copy-Item .env.example .env' in PowerShell)
# DO NOT commit the .env file containing real secrets to Git.
# =====================================================================

# --- Network & Agent Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Agentverse & ASI:One Credentials ---
# Required when registering/deploying agents to Agentverse or Mailbox
AGENTVERSE_API_KEY=your_agentverse_api_key_here
AGENTVERSE_URL=https://agentverse.ai
USE_MAILBOX=true

# --- Private Agent Seeds (Use unique, random seeds in production) ---
# For local development, seeds ensure consistent agent addresses across restarts.
ORCHESTRATOR_AGENT_SEED=replace_with_orchestrator_seed
MARKET_AGENT_SEED=replace_with_market_seed
WEATHER_AGENT_SEED=replace_with_weather_seed
BUYER_AGENT_SEED=replace_with_buyer_seed
BUYER_B_AGENT_SEED=replace_with_buyer_b_seed
TRANSPORT_AGENT_SEED=replace_with_transport_seed

# --- Agent Endpoint Ports (Local Multi-Agent Execution) ---
ORCHESTRATOR_PORT=8000
MARKET_AGENT_PORT=8001
WEATHER_AGENT_PORT=8002
BUYER_AGENT_PORT=8003
BUYER_B_AGENT_PORT=8005
TRANSPORT_AGENT_PORT=8004

# --- Specialist Agent Addresses (Inter-Agent Communication) ---
# Registered Agentverse / Almanac addresses (e.g. agent1q...) once published.
# Leave blank for local development to use local direct-service fallback.
MARKET_AGENT_ADDRESS=
WEATHER_AGENT_ADDRESS=
BUYER_AGENT_ADDRESS=
BUYER_B_AGENT_ADDRESS=
TRANSPORT_AGENT_ADDRESS=
ALLOW_DIRECT_SERVICE_FALLBACK=true

# --- External APIs ---
# Official Indian Open Government Data (data.gov.in) API Key for Agmarknet Mandi data.
# When left empty, Market Agent transparently serves verified benchmark mandi records.
DATAGOV_API_KEY=

# Open-Meteo does not require an API key (free & open service)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- ASI:One Developer API ---
# Official ASI:One API key for structured natural-language intent extraction.
# OpenAI-compatible endpoint: https://api.asi1.ai/v1/chat/completions
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1-mini
ASI_ONE_TIMEOUT_SECONDS=15.0

# --- Persistent Storage ---
DATABASE_PATH=krishibazaar.db

# --- Fetch.ai Agent Payment Protocol (Phase 9 - Safe Defaults) ---
# Payments are disabled by default. Set to true only when authorized with funded testnet wallets.
ENABLE_PAYMENT_PROTOCOL=false
PAYMENT_ENVIRONMENT=disabled
PAYMENT_NETWORK=testnet
PAYMENT_TESTNET_CHAIN_ID=dorado-1
PAYMENT_TESTNET_RPC_URL=grpc+https://grpc-dorado.fetch.ai
PAYMENT_TESTNET_DENOM=atestfet
PAYMENT_AGENT_PORT=8006
PAYMENT_ADVISORY_FEE_BASE_UNITS=50000000000000000

# Dedicated Testnet Wallets (BIP39 mnemonic / seeds kept strictly local in .env)
# Payer wallet (funds advisory fee transfers):
PAYMENT_PAYER_SEED=
# Payee specialist agent seed & verified wallet (controls receipt on port 8006):
PAYMENT_PAYEE_SEED=
PAYMENT_PAYEE_WALLET_ADDRESS=fetch1n09y85ndck56dmxrud7xpkmal0qqtqsej36u0h
PAYMENT_PAYEE_AGENT_ADDRESS=agent1qd3h83llg09jmurahgs3tk32wvu6g066zhvpl54gkr0pk5nx6jdp7ppsfnc
# Verified recipient whitelist (comma-separated fetch1... addresses; self-payment prohibited):
PAYMENT_RECIPIENT_WHITELIST=fetch1n09y85ndck56dmxrud7xpkmal0qqtqsej36u0h
